{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadup.dev/schemas/opportunity.schema.json",
  "title": "BreadUp Opportunity",
  "type": "object",
  "required": ["id","scanner_id","scanner_version","created_at","expires_at","market","target","economics","confidence","evidence_tier"],
  "properties": {
    "id": {"type":"string"},
    "scanner_id": {"type":"string"},
    "scanner_version": {"type":"string"},
    "created_at": {"type":"string","format":"date-time"},
    "expires_at": {"type":"string","format":"date-time"},
    "market": {"type":"string"},
    "target": {
      "type":"object",
      "required":["kind","label"],
      "properties": {
        "kind":{"enum":["listing","sku","niche","supplier","keyword","campaign","other"]},
        "label":{"type":"string"},
        "external_id":{"type":["string","null"]},
        "url":{"type":["string","null"],"format":"uri"}
      },
      "additionalProperties": true
    },
    "economics": {
      "type":"object",
      "required":["acquisition_cost","expected_net_sale_proceeds","expected_residual_value","sale_probability_horizon","capital_at_risk","ev","eroc"],
      "properties": {
        "currency":{"type":"string","default":"USD"},
        "acquisition_cost":{"type":"number"},
        "expected_net_sale_proceeds":{"type":"number"},
        "expected_residual_value":{"type":"number"},
        "sale_probability_horizon":{"type":"number","minimum":0,"maximum":1},
        "horizon_days":{"type":"number","minimum":0},
        "capital_at_risk":{"type":"number","minimum":0},
        "fair_value":{"type":["number","null"]},
        "edge":{"type":["number","null"]},
        "ev":{"type":"number"},
        "eroc":{"type":"number"}
      }
    },
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "evidence_tier":{"enum":["E0","E1","E2","E3","E4"]},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "teaser":{"type":"object"},
    "reveal":{"type":"object"},
    "provenance_hash":{"type":"string"}
  },
  "additionalProperties": false
}
